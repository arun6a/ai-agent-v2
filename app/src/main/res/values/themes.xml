<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ====== AI Agent v2 — App XML theme ====== -->
    <!-- This theme is only used for the Activity boot BEFORE Compose takes
         over with AIAgentTheme(). It just sets windowBackground + NoActionBar
         so there's no white flash on cold start. All real styling happens
         inside Compose. -->

    <style name="Theme.AIAgentV2" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Match the Compose canvas color so there's no flicker on startup -->
        <item name="android:windowBackground">@color/canvas_light</item>
        <item name="android:statusBarColor">@color/canvas_light</item>
        <item name="android:navigationBarColor">@color/canvas_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Smooth keyboard transitions + edge-to-edge layout -->
        <item name="android:windowSoftInputMode">adjustResize</item>
        <!-- Remove the default window action bar shadow -->
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- ====== Splash theme ====== -->
    <!-- Same as the main theme but explicitly uses the canvas background so the
         splash screen matches the SplashScreen composable's background exactly.
         Used by the Activity while the SplashScreen composable renders. -->
    <style name="Theme.AIAgentV2.Splash" parent="Theme.AIAgentV2">
        <item name="android:windowBackground">@color/canvas_light</item>
    </style>

</resources>
