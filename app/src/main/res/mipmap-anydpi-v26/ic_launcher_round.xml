<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher_round — alias to ic_launcher.
  Adaptive icons already get their shape from the launcher, so the "round"
  variant just points at the same adaptive-icon definition (Aira logo).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/aira_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
