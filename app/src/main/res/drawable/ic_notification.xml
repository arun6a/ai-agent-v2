<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_notification — status-bar notification icon.
  Android requires notification icons to be a single-color silhouette
  (white on transparent) so the system can tint them appropriately.
  This is the simplified silhouette of the launcher (hexagon + orb + circuit).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Hexagon outline -->
    <path
        android:pathData="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:fillType="evenOdd"
        android:strokeAlpha="0.6" />

    <!-- Center orb -->
    <path
        android:pathData="M12,12 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Center dot cutout (transparent) -->
    <path
        android:pathData="M12,12 m-1.5,0 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0"
        android:fillColor="#00000000" />

</vector>
