<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher_foreground — Concept 1 "Emerald Orb on dark"
  Hexagon outline + emerald orb with circuit lines + outer vertex dots.
  Drawn on a 108x108 viewport (adaptive icon standard); content sits within
  the inner 72dp safe zone so it survives all launcher masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow halo (soft emerald ring around the orb) -->
    <path
        android:pathData="M54,30 m-26,0 a26,26 0 1 0 52,0 a26,26 0 1 0 -52,0"
        android:fillColor="#10B981"
        android:fillAlpha="0.10" />

    <!-- Hexagon outline (faint emerald) -->
    <path
        android:pathData="M54,22 L84,40 L84,68 L54,86 L24,68 L24,40 Z"
        android:strokeColor="#10B981"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.45"
        android:fillType="evenOdd" />

    <!-- Emerald orb — outer ring (Accent2 pressed) -->
    <path
        android:pathData="M54,30 m-22,0 a22,22 0 1 0 44,0 a22,22 0 1 0 -44,0"
        android:fillColor="#059669" />

    <!-- Emerald orb — mid ring (Accent) -->
    <path
        android:pathData="M54,32 m-20,0 a20,20 0 1 0 40,0 a20,20 0 1 0 -40,0"
        android:fillColor="#10B981" />

    <!-- Emerald orb — inner highlight (Accent3 hover) -->
    <path
        android:pathData="M54,40 m-12,0 a12,12 0 1 0 24,0 a12,12 0 1 0 -24,0"
        android:fillColor="#34D399"
        android:fillAlpha="0.55" />

    <!-- Brain circuit lines (3 crossings) -->
    <path
        android:pathData="M54,32 L54,76 M40,40 L68,68 M40,68 L68,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.7"
        android:strokeLineCap="round" />

    <!-- Center white node -->
    <path
        android:pathData="M54,50 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0"
        android:fillColor="#FFFFFF" />

    <!-- Outer vertex dots (Accent3 — emerald glow nodes) -->
    <path android:pathData="M54,22 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />
    <path android:pathData="M84,40 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />
    <path android:pathData="M84,68 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />
    <path android:pathData="M54,86 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />
    <path android:pathData="M24,68 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />
    <path android:pathData="M24,40 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" android:fillColor="#34D399" />

</vector>
